# Environment Variables Template
# Copy this file to .env and fill in your values

# ==================== Local Development ====================
# Qianwen API Key (for local testing)
QIANWEN_API_KEY=your-local-api-key-here

# ==================== Production (Cloud Run) ====================
# These are set automatically by Cloud Run, no need to set locally

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=research-assistant-prod

# Firestore Database
FIRESTORE_DATABASE=(default)

# Firebase Storage Bucket
STORAGE_BUCKET=research-assistant-prod.appspot.com

# Port (Cloud Run sets this automatically)
PORT=8080

# NOTE: In production, QIANWEN_API_KEY is stored in Google Secret Manager
# and injected into Cloud Run via --set-secrets flag
